# Configuracion del servidor
PORT=8001

# Configuracion de la base de datos (Host Local)
# Si corres fuera de Docker: localhost
# Si corres dentro de Docker: host.docker.internal
DATABASE_URL=postgresql+asyncpg://postgres:tu_password_aqui@host.docker.internal:5432/BBDD_playa

# Configuracion de seguridad
SECRET_KEY=tu_clave_secreta_muy_segura_aqui_cambiala_en_produccion

# Configuracion de email (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=tu_correo@gmail.com
EMAIL_PASSWORD=tu_app_password
EMAIL_FROM=tu_correo@gmail.com

# Configuracion de Google OAuth
GOOGLE_CLIENT_ID=tu_client_id
GOOGLE_CLIENT_SECRET=tu_client_secret

# Configuracion de IA (Opcional - Ollama)
DOCUMENTOS_LLM_URL=http://host.docker.internal:11434
DOCUMENTOS_LLM_MODEL=llama3.2
