# Copiar a .env.production en la raíz del repo en el VPS (no commitear secretos).
# Docker Compose sustituye estas variables en docker-compose.prod.yml

# URL base del API tal como la ve el navegador al usar MiCoche / catálogo público.
# Mismo dominio y reverse proxy con prefijo /api:
VITE_PUBLIC_API_URL=/api

# Si el frontend estático y el API están en orígenes distintos (CORS ya debe estar en backend):
# VITE_PUBLIC_API_URL=https://api.tudominio.com

# Puertos en el host (opcional; por defecto 8002, 3002, 3003)
# BACKEND_HOST_PORT=8002
# FRONTEND_HOST_PORT=3002
# PUBLIC_CATALOG_HOST_PORT=3003
