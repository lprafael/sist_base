# =========================================================================
# CONFIGURACIÓN DE DOMINIOS - MI CANCHA (Bypass Cloudflare Proxy con tls internal)
# =========================================================================

# 1. Landing Page Pública (micancha-public)
micancha.com.py {
    tls internal
    reverse_proxy public:3000
}

# 2. Portal de Clientes (micancha-web)
play.micancha.com.py {
    tls internal
    reverse_proxy web:3000
}

# 3. Portal Administrativo (micancha-admin)
admin.micancha.com.py {
    reverse_proxy admin:3000
    tls internal
}


